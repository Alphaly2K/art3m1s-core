        "ART_UI_WINDOW_ACTION": "artemis-services-v2.schema.json#/$defs/windowAction",
        "ART_UI_AVOID": "artemis-services-v2.schema.json#/$defs/avoid",
        "ART_UI_HTTP_REQUEST": "artemis-services-v2.schema.json#/$defs/httpRequest",
        "ART_UI_HTTP_CANCEL": "artemis-services-v2.schema.json#/$defs/httpCancel",
        "ART_UI_TRANSLATE": "artemis-services-v2.schema.json#/$defs/translationRequest",
        "ART_UI_OPEN_BROWSER": "artemis-services-v2.schema.json#/$defs/openBrowser"
