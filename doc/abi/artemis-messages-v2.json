      "submissions": {
        "ART_IO_STAT": "artemis-io-v2.schema.json#/$defs/statReply",
        "ART_IO_READ": "artemis-io-v2.schema.json#/$defs/readReply",
        "ART_IO_WRITE_ATOMIC": "artemis-io-v2.schema.json#/$defs/writeReply",
