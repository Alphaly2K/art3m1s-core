      "submissions": {
        "ART_UI_DIALOG": "artemis-services-v2.schema.json#/$defs/dialogReply",
        "ART_UI_HTTP_REQUEST": "artemis-services-v2.schema.json#/$defs/httpReply",
        "ART_UI_TRANSLATE": "artemis-services-v2.schema.json#/$defs/translationReply"
