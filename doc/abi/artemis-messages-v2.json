      "submissions": {
        "ART_MEDIA_PLAYBACK_STATUS": "artemis-media-v2.schema.json#/$defs/playbackStatus",
        "ART_MEDIA_VIDEO_FRAME": "artemis-media-v2.schema.json#/$defs/videoFrame"
