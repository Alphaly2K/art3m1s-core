        "ART_RUNTIME_PROJECT_READY": "artemis-services-v2.schema.json#/$defs/noFields",
        "ART_RUNTIME_EXIT_REQUESTED": "artemis-services-v2.schema.json#/$defs/noFields",
        "ART_RUNTIME_CLOSED_EVENT": "artemis-services-v2.schema.json#/$defs/runtimeClosed",
        "ART_RUNTIME_PERSISTENCE_RESULT": "artemis-services-v2.schema.json#/$defs/persistenceResult"
      },
      "submissions": {
        "ART_RUNTIME_SHUTDOWN": "artemis-services-v2.schema.json#/$defs/noFields",
        "ART_RUNTIME_SET_DEFAULT_FONT": "artemis-services-v2.schema.json#/$defs/noFields",
        "ART_RUNTIME_CANCEL_IO": "artemis-io-v2.schema.json#/$defs/cancelIo"
      }
    },
    "ART_DOMAIN_INPUT": {
      "submissions": {
        "ART_INPUT_KEY": "artemis-services-v2.schema.json#/$defs/keyInput",
        "ART_INPUT_POINTER": "artemis-services-v2.schema.json#/$defs/pointerInput",
        "ART_INPUT_TOUCH": "artemis-services-v2.schema.json#/$defs/touchInput",
        "ART_INPUT_FOCUS_LOST": "artemis-services-v2.schema.json#/$defs/noFields",
