        "ART_INPUT_WINDOW_STATE": "artemis-services-v2.schema.json#/$defs/windowStateInput"
      }
    },
    "ART_DOMAIN_IO": {
      "events": {
        "ART_IO_STAT": "artemis-io-v2.schema.json#/$defs/statRequest",
        "ART_IO_READ": "artemis-io-v2.schema.json#/$defs/readRequest",
        "ART_IO_WRITE_ATOMIC": "artemis-io-v2.schema.json#/$defs/writeRequest",
        "ART_IO_DELETE": "artemis-io-v2.schema.json#/$defs/deleteRequest",
        "ART_IO_WRITE_ABORT": "artemis-io-v2.schema.json#/$defs/writeAbort"
